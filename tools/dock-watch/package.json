{
  "name": "@jwbz/dock-watch",
  "version": "1.0.0",
  "private": true,
  "description": "工具坞工具包（dock-watch）—— 后台值守进程：Obsidian 关着时，替它按同一份规则表跑外部工具（判据/执行/记账全在 src/dock，打包成 dock-core.cjs）",
  "main": "watch.js",
  "bin": {
    "bz-dock-watch": "./cli.js"
  },
  "files": [
    "cli.js",
    "watch.js",
    "node-fs.js",
    "runtime.js",
    "net.js",
    "dock-core.cjs",
    "core-version.json",
    "install.ps1",
    "uninstall.ps1",
    "README.md",
    "CONTEXT.md",
    "test/"
  ],
  "scripts": {
    "start": "node cli.js",
    "once": "node cli.js --once",
    "status": "node cli.js --status",
    "check": "node --check cli.js && node --check watch.js && node --check node-fs.js && node --check runtime.js && node --check net.js",
    "test": "npm run check && node --test \"test/*.test.mjs\""
  },
  "keywords": [
    "obsidian",
    "dock",
    "watchdog",
    "scheduler"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
